# Copernico environment template. Placeholders only: never commit real values.
# Public client configuration (safe to expose in the browser bundle).
VITE_API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
VITE_COGNITO_CLIENT_ID=exampleclientid
VITE_TURNSTILE_SITE_KEY=example-site-key
VITE_DATA_BASE_URL=/data

# Server-side only. The Gemini key is NEVER stored in files: it lives in SSM Parameter Store
# (SecureString) and is read by the assistant Lambda at runtime. See docs/security.md.
COPERNICO_ENV=dev
AI_PROVIDER=mock
